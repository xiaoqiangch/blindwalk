    {
      "id": "poi-db70d9",
      "name": "人民广场",
      "lat": 31.229564,
      "lon": 121.47438,
      "category": "plaza",
      "emoji": "⛲️",
      "rarity": "common",
      "area": "near",
      "address": null,
      "photoUrl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Peoples_Square.jpg/960px-Peoples_Square.jpg?utm_source=zh.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
      "photoCredit": "Wikimedia Commons",
      "summary": "人民广场位于上海市黄浦区，是上海的政治、经济、文化、旅游中心和交通枢纽，也是上海最为重要的地标之一。 广义上的“人民广场”主要是由一个开放式的广场、人民公园以及周边一些文化、旅游、商业建筑等组成。",
      "why": "「广场」适合不赶时间地待一会儿。\n到了才知道是哪里，这个地点只为你亮一次。",
      "task": "观察 30 秒，找出走得最慢的那个人。",
      "hints": [
        "人会变多。",
        "找一块空着的石头或台阶。",
        "就在前面。抬手机，慢慢看。"
      ],
