# 后台登录密码（必填；不填则首次启动自动生成，见启动日志）
WA_ADMIN_PASSWORD=

# 步迷 Walkaholic · 兴趣点管理后台环境变量示例
# 复制为 .env 后按需填写；不配置 WA_LLM_API_KEY 时自动使用「离线规则模式」。
# 注意：.env 只在 node server/index.mjs 启动时读取，不会提交真实 Key。

# ---- 大模型（OpenAI 兼容） ----
WA_LLM_BASE_URL=https://api.deepseek.com/v1
WA_LLM_API_KEY=
WA_LLM_MODEL=deepseek-chat

# ---- 服务 ----
PORT=8802
# HOST=127.0.0.1

# ---- 可选路径（默认值见 server/index.mjs） ----
# WA_DATA_DIR=./data
# WA_PUBLIC_DIR=./public
# WA_EXPORT_PATH=../prototype/web/pois.json
