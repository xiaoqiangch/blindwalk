# 盲走 BlindWalk · 兴趣点管理后台环境变量示例
# 复制为 .env 后按需填写；不配置 BW_LLM_API_KEY 时自动使用「离线规则模式」。
# 注意：.env 只在 node server/index.mjs 启动时读取，不会提交真实 Key。

# ---- 大模型（OpenAI 兼容） ----
BW_LLM_BASE_URL=https://api.deepseek.com/v1
BW_LLM_API_KEY=
BW_LLM_MODEL=deepseek-chat

# ---- 服务 ----
PORT=8802
# HOST=127.0.0.1

# ---- 可选路径（默认值见 server/index.mjs） ----
# BW_DATA_DIR=./data
# BW_PUBLIC_DIR=./public
# BW_EXPORT_PATH=../prototype/web/pois.json
