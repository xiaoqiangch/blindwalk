# 步迷 Walkaholic · 账号服务环境变量示例
# 复制为 account/.env 后按需修改；PORT 也可直接通过命令行传入。

# ---- 服务 ----
PORT=8803
HOST=127.0.0.1
# 数据目录（默认 account/data）
# WA_DATA_DIR=./data

# ---- CORS ----
# 不设置 = 回显任意请求 Origin（带 Allow-Credentials，便于本地 PWA 预览）
# 部署时建议配置成明确的白名单（逗号分隔），例如：
# WA_ALLOWED_ORIGINS=http://127.0.0.1:8799,https://walkaholic.example

# ---- Cookie / 代理 ----
# 部署 HTTPS 时必须设为 1（给 Cookie 加 Secure）；本地 http 保持 0
WA_COOKIE_SECURE=0
# 放在反向代理（Nginx/Caddy）之后时设为 1，限流按 X-Forwarded-For 的真实 IP
WA_TRUST_PROXY=0
