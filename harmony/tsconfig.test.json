{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "lib": ["ES2021"],
    "types": []
  },
  "include": ["entry/src/main/ets/core/**/*.ts", "tests/**/*.ts"]
}
